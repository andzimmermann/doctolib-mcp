[Unit]
Description=ChangePoint personal Doctolib MCP backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=doctolib
Group=doctolib
WorkingDirectory=/srv/doctolib-mcp
Environment=PYTHONPATH=/srv/doctolib-mcp/src
Environment=DOCTOLIB_AUTO_LOGIN=0
EnvironmentFile=/etc/doctolib/backend.env
ExecStart=/srv/doctolib-mcp/.venv/bin/python -m doctolib_mcp.http_server
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
